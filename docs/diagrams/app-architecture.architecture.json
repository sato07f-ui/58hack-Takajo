  "cards": [
    {
      "dot": "cyan",
      "title": "AR ゲーム",
      "items": [
        "MindAR の画像認識と COCO-SSD の物体認識を並走させ、先に見つけた方で敵を 1 体出す",
        "createScene が敵 glb をカメラ前 0.5 m に配置し、向きセンサーでカメラを回す",
        "App.jsx の攻撃ボタンが sceneRef 経由で playDamageEffect を呼ぶ"
      ]
    },
    {
      "dot": "emerald",
      "title": "見守りモード",
      "items": [
        "ルームコードごとの Supabase チャンネルに親子が入り、位置を Broadcast で送り合う",
        "haversine で距離を出し、50 m 超が 5 秒続けば脱出、10 m 以内が 3 秒続けば復活の鍵を送る",
        "Presence と 30 秒無受信で相手の途絶を表示"
      ]
    },
    {
      "dot": "amber",
      "title": "設定",
      "items": [
        "VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY を .env.local に置く",
        ".mind は public/targets/、glb は src/assets/ に配置",
        "実機確認は npm run tunnel (cloudflared) で HTTPS 経由"
      ]
    }
  ]
